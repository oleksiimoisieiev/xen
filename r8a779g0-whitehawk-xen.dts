/dts-v1/;

/ {
	compatible = "renesas,whitehawk-cpu\0renesas,r8a779g0";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Renesas White Hawk CPU boards based on r8a779g0";

	aliases {
		i2c0 = "/soc/i2c@e6500000";
		i2c1 = "/soc/i2c@e6508000";
		i2c2 = "/soc/i2c@e6510000";
		i2c3 = "/soc/i2c@e66d0000";
		i2c4 = "/soc/i2c@e66d8000";
		i2c5 = "/soc/i2c@e66e0000";
		serial0 = "/soc/serial@e6540000";
		ethernet0 = "/soc/ethernet@e6800000";
	};

	can {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		phandle = <0x62>;
	};

	opp_table10 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x08>;

		opp-500000000 {
			opp-hz = <0x00 0x1dcd6500>;
			opp-microvolt = <0xc96a8>;
			clock-latency-ns = <0x7a120>;
		};

		opp-1000000000 {
			opp-hz = <0x00 0x3b9aca00>;
			opp-microvolt = <0xc96a8>;
			clock-latency-ns = <0x7a120>;
		};

		opp-1500000000 {
			opp-hz = <0x00 0x59682f00>;
			opp-microvolt = <0xc96a8>;
			clock-latency-ns = <0x7a120>;
		};

		opp-1700000000 {
			opp-hz = <0x00 0x6553f100>;
			opp-microvolt = <0xc96a8>;
			clock-latency-ns = <0x7a120>;
			opp-suspend;
		};

		opp-1800000000 {
			opp-hz = <0x00 0x6b49d200>;
			opp-microvolt = <0xd6d80>;
			clock-latency-ns = <0x7a120>;
			turbo-mode;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x01>;
				};

				core1 {
					cpu = <0x02>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x03>;
				};

				core1 {
					cpu = <0x04>;
				};
			};
		};

		cpu@0 {
			compatible = "arm,cortex-a76";
			reg = <0x00>;
			device_type = "cpu";
			power-domains = <0x05 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x06>;
			clocks = <0x07 0x00 0x53>;
			operating-points-v2 = <0x08>;
			next-level-cache = <0x09>;
			phandle = <0x01>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a76\0arm,armv8";
			reg = <0x100>;
			power-domains = <0x05 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x06>;
			clocks = <0x07 0x00 0x53>;
			operating-points-v2 = <0x08>;
			next-level-cache = <0x09>;
			phandle = <0x02>;
		};

		cpu@10000 {
			device_type = "cpu";
			compatible = "arm,cortex-a76\0arm,armv8";
			reg = <0x10000>;
			power-domains = <0x05 0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x06>;
			clocks = <0x07 0x00 0x53>;
			operating-points-v2 = <0x08>;
			next-level-cache = <0x0a>;
			phandle = <0x03>;
		};

		cpu@10100 {
			device_type = "cpu";
			compatible = "arm,cortex-a76\0arm,armv8";
			reg = <0x10100>;
			power-domains = <0x05 0x03>;
			enable-method = "psci";
			cpu-idle-states = <0x06>;
			clocks = <0x07 0x00 0x53>;
			operating-points-v2 = <0x08>;
			next-level-cache = <0x0a>;
			phandle = <0x04>;
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x190>;
				exit-latency-us = <0x1f4>;
				min-residency-us = <0xfa0>;
				status = "okay";
				phandle = <0x06>;
			};
		};

		cache-controller-0 {
			compatible = "cache";
			power-domains = <0x05 0x10>;
			cache-unified;
			cache-level = <0x03>;
			phandle = <0x09>;
		};

		cache-controller-1 {
			compatible = "cache";
			power-domains = <0x05 0x11>;
			cache-unified;
			cache-level = <0x03>;
			phandle = <0x0a>;
		};
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	extal {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xfe502a>;
		phandle = <0x0e>;
	};

	extalr {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x8000>;
		phandle = <0x0f>;
	};

	pmu_a76 {
		compatible = "arm,cortex-a76-pmu";
		interrupts-extended = <0x0b 0x01 0x07 0x08>;
	};

	scif {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		phandle = <0x32>;
	};

	pcie_bus {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x5f5e100>;
	};

	audio_clkin {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		phandle = <0x6b>;
	};

	soc {
		compatible = "simple-bus";
		interrupt-parent = <0x0b>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		pin-controller@e6050000 {
			compatible = "renesas,pfc-r8a779g0";
			reg = <0x00 0xe6050000 0x00 0x16c 0x00 0xe6050800 0x00 0x16c 0x00 0xe6058000 0x00 0x16c 0x00 0xe6058800 0x00 0x16c 0x00 0xe6060000 0x00 0x16c 0x00 0xe6060800 0x00 0x16c 0x00 0xe6061000 0x00 0x16c 0x00 0xe6061800 0x00 0x16c 0x00 0xe6068000 0x00 0x16c>;
			pinctrl-0 = <0x0c>;
			pinctrl-names = "default";
			phandle = <0x0d>;

			i2c0 {
				groups = "i2c0";
				function = "i2c0";
				phandle = <0x18>;
			};

			i2c5 {
				groups = "i2c5";
				function = "i2c5";
				phandle = <0x31>;
			};

			qspi0 {
				groups = "qspi0_ctrl\0qspi0_data4";
				function = "qspi0";
				phandle = <0x44>;
			};

			scif0 {
				groups = "scif0_data\0scif0_ctrl";
				function = "scif0";
				phandle = <0x3f>;
			};

			hscif0 {
				groups = "hscif0_data\0hscif0_ctrl";
				function = "hscif0";
				phandle = <0x33>;
			};

			scif_clk {
				groups = "scif_clk";
				function = "scif_clk";
				phandle = <0x0c>;
			};

			mmc {
				groups = "mmc_data8\0mmc_ctrl\0mmc_ds";
				function = "mmc";
				power-source = <0x708>;
				phandle = <0x41>;
			};

			sound {
				groups = "ssi_ctrl\0ssi_data";
				function = "ssi";
				phandle = <0x6d>;
			};

			sound_clk {
				groups = "audio_clkin\0audio_clkout";
				function = "audio_clk";
				phandle = <0x6c>;
			};

			vddq_eth {
				phandle = <0x11>;

				pins_pwr {
					pins = "GP_4_0\0GP_5_0\0GP_6_0\0GP_7_0";
					power-source = <0xce4>;
				};
			};

			avb0 {
				phandle = <0x34>;

				mux {
					groups = "avb0_link\0avb0_mdio\0avb0_rgmii\0avb0_txcrefclk";
					function = "avb0";
				};

				pins_mdio {
					groups = "avb0_mdio";
					drive-strength = <0x15>;
				};

				pins_mii {
					groups = "avb0_rgmii";
					drive-strength = <0x15>;
				};
			};

			avb1 {
				phandle = <0x37>;

				mux {
					groups = "avb1_link\0avb1_mdio\0avb1_rgmii\0avb1_txcrefclk";
					function = "avb1";
				};

				pins_mdio {
					groups = "avb1_mdio";
					drive-strength = <0x18>;
				};

				pins_mii_tx {
					pins = "GP_6_7\0GP_6_6\0GP_6_13\0GP_6_12\0GP_6_16\0GP_6_18";
					drive-strength = <0x18>;
				};

				pin_tx_ctl {
					pins = "GP_6_7";
					bias-pull-up;
				};

				pins_puen_disable {
					pins = "GP_6_0\0GP_6_1\0GP_6_2\0GP_6_3\0GP_6_4\0GP_6_5\0GP_6_6\0GP_6_8\0GP_6_9\0GP_6_10\0GP_6_11\0GP_6_12\0GP_6_13\0GP_6_14\0GP_6_15\0GP_6_16\0GP_6_17\0GP_6_18\0GP_6_19\0GP_6_20";
					bias-disable;
				};
			};

			avb2 {
				phandle = <0x3a>;

				mux {
					groups = "avb2_link\0avb2_mdio\0avb2_rgmii\0avb2_txcrefclk";
					function = "avb2";
				};

				pins_mdio {
					groups = "avb2_mdio";
					drive-strength = <0x18>;
				};

				pin_tx_ctl {
					pins = "GP_5_19";
					bias-pull-up;
				};

				pins_puen_disable {
					pins = "GP_5_0\0GP_5_1\0GP_5_2\0GP_5_3\0GP_5_4\0GP_5_5\0GP_5_6\0GP_5_7\0GP_5_8\0GP_5_9\0GP_5_10\0GP_5_11\0GP_5_12\0GP_5_13\0GP_5_14\0GP_5_15\0GP_5_16\0GP_5_17\0GP_5_18\0GP_5_20";
					bias-disable;
				};
			};

			tsn0 {
				phandle = <0x10>;

				mux {
					groups = "tsn0_link\0tsn0_mdio\0tsn0_rgmii\0tsn0_txcrefclk";
					function = "tsn0";
				};

				pins_mdio {
					groups = "tsn0_mdio";
					drive-strength = <0x15>;
				};

				pins_mii {
					groups = "tsn0_rgmii";
					drive-strength = <0x15>;
				};
			};

			i2c1 {
				groups = "i2c1";
				function = "i2c1";
				phandle = <0x1a>;
			};

			i2c4 {
				groups = "i2c4";
				function = "i2c4";
				phandle = <0x30>;
			};

			canfd0 {
				groups = "canfd0_data";
				function = "canfd0";
				phandle = <0x63>;
			};

			canfd1 {
				groups = "canfd1_data";
				function = "canfd1";
				phandle = <0x64>;
			};

			canfd2 {
				groups = "canfd2_data";
				function = "canfd2";
				phandle = <0x65>;
			};

			canfd3 {
				groups = "canfd3_data";
				function = "canfd3";
				phandle = <0x66>;
			};

			canfd4 {
				groups = "canfd4_data";
				function = "canfd4";
				phandle = <0x67>;
			};

			canfd5 {
				groups = "canfd5_data";
				function = "canfd5";
				phandle = <0x68>;
			};

			canfd6 {
				groups = "canfd6_data";
				function = "canfd6";
				phandle = <0x69>;
			};

			canfd7 {
				groups = "canfd7_data";
				function = "canfd7";
				phandle = <0x6a>;
			};
		};

		watchdog@e6020000 {
			compatible = "renesas,r8a779g0-wdt\0renesas,rcar-gen4-wdt";
			reg = <0x00 0xe6020000 0x00 0x0c>;
			clocks = <0x07 0x01 0x38b>;
			power-domains = <0x05 0x40>;
			resets = <0x07 0x38b>;
			status = "okay";
			timeout-sec = <0x3c>;
		};

		gpio@e6050180 {
			compatible = "renesas,gpio-r8a779g0\0renesas,rcar-gen4-gpio";
			reg = <0x00 0xe6050180 0x00 0x54>;
			interrupts = <0x00 0x26b 0x04>;
			#gpio-cells = <0x02>;
			gpio-controller;
			gpio-ranges = <0x0d 0x00 0x00 0x13>;
			#interrupt-cells = <0x02>;
			interrupt-controller;
			clocks = <0x07 0x01 0x393>;
			power-domains = <0x05 0x40>;
			resets = <0x07 0x393>;
			xen,passthrough;
			phandle = <0x19>;
		};

		gpio@e6050980 {
			compatible = "renesas,gpio-r8a779g0\0renesas,rcar-gen4-gpio";
			reg = <0x00 0xe6050980 0x00 0x54>;
			interrupts = <0x00 0x26f 0x04>;
			#gpio-cells = <0x02>;
			gpio-controller;
			gpio-ranges = <0x0d 0x00 0x20 0x1d>;
			#interrupt-cells = <0x02>;
			interrupt-controller;
			clocks = <0x07 0x01 0x393>;
			power-domains = <0x05 0x40>;
			resets = <0x07 0x393>;
			xen,passthrough;
			phandle = <0x15>;
		};

		gpio@e6058180 {
			compatible = "renesas,gpio-r8a779g0\0renesas,rcar-gen4-gpio";
			reg = <0x00 0xe6058180 0x00 0x54>;
			interrupts = <0x00 0x273 0x04>;
			#gpio-cells = <0x02>;
			gpio-controller;
			gpio-ranges = <0x0d 0x00 0x40 0x14>;
			#interrupt-cells = <0x02>;
			interrupt-controller;
			clocks = <0x07 0x01 0x394>;
			power-domains = <0x05 0x40>;
			resets = <0x07 0x394>;
			xen,passthrough;
		};

		gpio@e6058980 {
			compatible = "renesas,gpio-r8a779g0\0renesas,rcar-gen4-gpio";
			reg = <0x00 0xe6058980 0x00 0x54>;
			interrupts = <0x00 0x277 0x04>;
			#gpio-cells = <0x02>;
			gpio-controller;
			gpio-ranges = <0x0d 0x00 0x60 0x1e>;
			#interrupt-cells = <0x02>;
			interrupt-controller;
			clocks = <0x07 0x01 0x394>;
			power-domains = <0x05 0x40>;
			resets = <0x07 0x394>;
			xen,passthrough;
		};

		gpio@e6060180 {
			compatible = "renesas,gpio-r8a779g0\0renesas,rcar-gen4-gpio";
			reg = <0x00 0xe6060180 0x00 0x54>;
			interrupts = <0x00 0x27b 0x04>;
			#gpio-cells = <0x02>;
			gpio-controller;
			gpio-ranges = <0x0d 0x00 0x80 0x19>;
			#interrupt-cells = <0x02>;
			interrupt-controller;
			clocks = <0x07 0x01 0x395>;
			power-domains = <0x05 0x40>;
			resets = <0x07 0x395>;
			xen,passthrough;
			phandle = <0x14>;

			pcie0-clkreq-hog {
				gpio-hog;
				gpios = <0x15 0x01>;
				output-high;
			};

			pcie1-clkreq-hog {
				gpio-hog;
				gpios = <0x16 0x01>;
				output-high;
			};
		};

		gpio@e6060980 {
			compatible = "renesas,gpio-r8a779g0\0renesas,rcar-gen4-gpio";
			reg = <0x00 0xe6060980 0x00 0x54>;
			interrupts = <0x00 0x27f 0x04>;
			#gpio-cells = <0x02>;
			gpio-controller;
			gpio-ranges = <0x0d 0x00 0xa0 0x15>;
			#interrupt-cells = <0x02>;
			interrupt-controller;
			clocks = <0x07 0x01 0x395>;
			power-domains = <0x05 0x40>;
			resets = <0x07 0x395>;
			xen,passthrough;
			phandle = <0x3c>;

			avb2_avtp_match {
				gpio-hog;
				gpios = <0x02 0x00>;
				output-high;
				line-name = "AVB2_AVTP_MAGIC";
			};

			avb2_avtp_pps {
				gpio-hog;
				gpios = <0x00 0x00>;
				output-high;
				line-name = "AVB2_AVTP_PPS";
			};

			avb2_avtp_capture {
				gpio-hog;
				gpios = <0x01 0x00>;
				output-high;
				line-name = "AVB2_AVTP_CAPTURE";
			};
		};

		gpio@e6061180 {
			compatible = "renesas,gpio-r8a779g0\0renesas,rcar-gen4-gpio";
			reg = <0x00 0xe6061180 0x00 0x54>;
			interrupts = <0x00 0x283 0x04>;
			#gpio-cells = <0x02>;
			gpio-controller;
			gpio-ranges = <0x0d 0x00 0xc0 0x15>;
			#interrupt-cells = <0x02>;
			interrupt-controller;
			clocks = <0x07 0x01 0x395>;
			power-domains = <0x05 0x40>;
			resets = <0x07 0x395>;
			xen,passthrough;
			phandle = <0x39>;

			avb1_avtp_match {
				gpio-hog;
				gpios = <0x05 0x00>;
				output-high;
				line-name = "AVB1_AVTP_MAGIC";
			};

			avb1_avtp_pps {
				gpio-hog;
				gpios = <0x0a 0x00>;
				output-high;
				line-name = "AVB1_AVTP_PPS";
			};

			avb1_avtp_capture {
				gpio-hog;
				gpios = <0x0b 0x00>;
				output-high;
				line-name = "AVB1_AVTP_CAPTURE";
			};
		};

		gpio@e6061980 {
			compatible = "renesas,gpio-r8a779g0\0renesas,rcar-gen4-gpio";
			reg = <0x00 0xe6061980 0x00 0x54>;
			interrupts = <0x00 0x287 0x04>;
			#gpio-cells = <0x02>;
			gpio-controller;
			gpio-ranges = <0x0d 0x00 0xe0 0x15>;
			#interrupt-cells = <0x02>;
			interrupt-controller;
			clocks = <0x07 0x01 0x395>;
			power-domains = <0x05 0x40>;
			resets = <0x07 0x395>;
			xen,passthrough;
			phandle = <0x36>;
		};

		gpio@e6068180 {
			compatible = "renesas,gpio-r8a779g0\0renesas,rcar-gen4-gpio";
			reg = <0x00 0xe6068180 0x00 0x54>;
			interrupts = <0x00 0x28b 0x04>;
			#gpio-cells = <0x02>;
			gpio-controller;
			gpio-ranges = <0x0d 0x00 0x100 0x0e>;
			#interrupt-cells = <0x02>;
			interrupt-controller;
			clocks = <0x07 0x01 0x396>;
			power-domains = <0x05 0x40>;
			resets = <0x07 0x396>;
			xen,passthrough;
		};

		timer@e60f0000 {
			compatible = "renesas,r8a779g0-cmt0\0renesas,rcar-gen4-cmt0";
			reg = <0x00 0xe60f0000 0x00 0x1004>;
			interrupts = <0x00 0x104 0x04 0x00 0x105 0x04>;
			clocks = <0x07 0x01 0x38e>;
			clock-names = "fck";
			power-domains = <0x05 0x40>;
			resets = <0x07 0x38e>;
			status = "okay";
		};

		timer@e6130000 {
			compatible = "renesas,r8a779g0-cmt1\0renesas,rcar-gen4-cmt1";
			reg = <0x00 0xe6130000 0x00 0x1004>;
			interrupts = <0x00 0x106 0x04 0x00 0x107 0x04 0x00 0x108 0x04 0x00 0x109 0x04 0x00 0x10a 0x04 0x00 0x10b 0x04 0x00 0x10c 0x04 0x00 0x10d 0x04>;
			clocks = <0x07 0x01 0x38f>;
			clock-names = "fck";
			power-domains = <0x05 0x40>;
			resets = <0x07 0x38f>;
			status = "okay";
		};

		timer@e6140000 {
			compatible = "renesas,r8a779g0-cmt1\0renesas,rcar-gen4-cmt1";
			reg = <0x00 0xe6140000 0x00 0x1004>;
			interrupts = <0x00 0x10e 0x04 0x00 0x10f 0x04 0x00 0x110 0x04 0x00 0x111 0x04 0x00 0x112 0x04 0x00 0x113 0x04 0x00 0x114 0x04 0x00 0x115 0x04>;
			clocks = <0x07 0x01 0x390>;
			clock-names = "fck";
			power-domains = <0x05 0x40>;
			resets = <0x07 0x390>;
			status = "okay";
		};

		timer@e6148000 {
