			reg = <0x00 0xffd60000 0x00 0x1000 0x00 0xffc10000 0x00 0x10000>;
			interrupts = <0x00 0x08 0x04 0x00 0x0a 0x04 0x00 0x0b 0x04 0x00 0x0c 0x04 0x00 0x0d 0x04 0x00 0x0e 0x04 0x00 0x0f 0x04 0x00 0x10 0x04 0x00 0x11 0x04 0x00 0x12 0x04 0x00 0x13 0x04 0x00 0x14 0x04 0x00 0x15 0x04 0x00 0x16 0x04 0x00 0x17 0x04 0x00 0x18 0x04 0x00 0x19 0x04>;
			interrupt-names = "error\0ch0\0ch1\0ch2\0ch3\0ch4\0ch5\0ch6\0ch7\0ch8\0ch9\0ch10\0ch11\0ch12\0ch13\0ch14\0ch15";
			clocks = <0x07 0x01 0x276>;
			clock-names = "fck";
			power-domains = <0x05 0x40>;
			resets = <0x07 0x276>;
			#dma-cells = <0x01>;
			dma-channels = <0x10>;
			status = "disabled";
			xen,passthrough;
		};

		dma-controller@ffd61000 {
			compatible = "renesas,dmac-r8a779g0";
			reg = <0x00 0xffd61000 0x00 0x1000 0x00 0xffc20000 0x00 0x10000>;
			interrupts = <0x00 0x1a 0x04 0x00 0x1c 0x04 0x00 0x1d 0x04 0x00 0x1e 0x04 0x00 0x1f 0x04 0x00 0x20 0x04 0x00 0x21 0x04 0x00 0x22 0x04 0x00 0x23 0x04 0x00 0x24 0x04 0x00 0x25 0x04 0x00 0x26 0x04 0x00 0x27 0x04 0x00 0x28 0x04 0x00 0x29 0x04 0x00 0x2a 0x04 0x00 0x2b 0x04>;
			interrupt-names = "error\0ch0\0ch1\0ch2\0ch3\0ch4\0ch5\0ch6\0ch7\0ch8\0ch9\0ch10\0ch11\0ch12\0ch13\0ch14\0ch15";
			clocks = <0x07 0x01 0x277>;
			clock-names = "fck";
			power-domains = <0x05 0x40>;
			resets = <0x07 0x277>;
			#dma-cells = <0x01>;
			dma-channels = <0x10>;
			status = "disabled";
			xen,passthrough;
		};

		dma-controller@ffd62000 {
			compatible = "renesas,dmac-r8a779g0";
			reg = <0x00 0xffd62000 0x00 0x1000 0x00 0xffd70000 0x00 0x10000>;
			interrupts = <0x00 0x2c 0x04 0x00 0x2e 0x04 0x00 0x2f 0x04 0x00 0x30 0x04 0x00 0x31 0x04 0x00 0x32 0x04 0x00 0x33 0x04 0x00 0x34 0x04 0x00 0x35 0x04 0x00 0x36 0x04 0x00 0x37 0x04 0x00 0x38 0x04 0x00 0x39 0x04 0x00 0x3a 0x04 0x00 0x3b 0x04 0x00 0x3c 0x04 0x00 0x3d 0x04>;
			interrupt-names = "error\0ch0\0ch1\0ch2\0ch3\0ch4\0ch5\0ch6\0ch7\0ch8\0ch9\0ch10\0ch11\0ch12\0ch13\0ch14\0ch15";
			clocks = <0x07 0x01 0x2bc>;
			clock-names = "fck";
			power-domains = <0x05 0x40>;
			resets = <0x07 0x2bc>;
			#dma-cells = <0x01>;
			dma-channels = <0x10>;
			status = "disabled";
			xen,passthrough;
		};

		dma-controller@ffd63000 {
			compatible = "renesas,dmac-r8a779g0";
			reg = <0x00 0xffd63000 0x00 0x1000 0x00 0xffd80000 0x00 0x10000>;
			interrupts = <0x00 0x3e 0x04 0x00 0x40 0x04 0x00 0x41 0x04 0x00 0x42 0x04 0x00 0x43 0x04 0x00 0x44 0x04 0x00 0x45 0x04 0x00 0x46 0x04 0x00 0x47 0x04 0x00 0x48 0x04 0x00 0x49 0x04 0x00 0x4a 0x04 0x00 0x4b 0x04 0x00 0x4c 0x04 0x00 0x4d 0x04 0x00 0x4e 0x04 0x00 0x4f 0x04>;
			interrupt-names = "error\0ch0\0ch1\0ch2\0ch3\0ch4\0ch5\0ch6\0ch7\0ch8\0ch9\0ch10\0ch11\0ch12\0ch13\0ch14\0ch15";
			clocks = <0x07 0x01 0x2bd>;
			clock-names = "fck";
			power-domains = <0x05 0x40>;
			resets = <0x07 0x2bd>;
			#dma-cells = <0x01>;
			dma-channels = <0x10>;
			status = "disabled";
			xen,passthrough;
		};

		can@e6660000 {
			compatible = "renesas,r8a779g0-canfd";
			reg = <0x00 0xe6660000 0x00 0x8600>;
			interrupts = <0x00 0x19c 0x04 0x00 0x19d 0x04>;
			clocks = <0x07 0x01 0x148 0x07 0x00 0x35 0x62>;
			clock-names = "fck\0canfd\0can_clk";
			assigned-clocks = <0x07 0x00 0x35>;
			assigned-clock-rates = <0x4c4b400>;
			power-domains = <0x05 0x40>;
			resets = <0x07 0x148>;
			status = "okay";
			pinctrl-0 = <0x63 0x64 0x65 0x66 0x67 0x68 0x69 0x6a>;
			pinctrl-names = "default";

			channel0 {
				status = "okay";
			};

			channel1 {
				status = "okay";
			};

			channel2 {
				status = "okay";
			};

			channel3 {
				status = "okay";
			};

			channel4 {
				status = "okay";
			};

			channel5 {
				status = "okay";
			};

			channel6 {
				status = "okay";
			};

			channel7 {
				status = "okay";
			};
		};

		sound@ec400000 {
			compatible = "renesas,rcar_sound-r8a779g0\0renesas,rcar_sound-gen4";
			reg = <0x00 0xec400000 0x00 0x40000 0x00 0xec540000 0x00 0x1000 0x00 0xec541000 0x00 0x50 0x00 0xec5a0000 0x00 0x20>;
			reg-names = "ssi_sdmc\0ssiu\0ssi\0adg";
			clocks = <0x07 0x01 0xb6e 0x07 0x01 0xb6f 0x6b>;
			clock-names = "ssiu.0\0ssi.0\0clk_a";
			power-domains = <0x05 0x40>;
			resets = <0x07 0xb6e 0x07 0xb6f>;
			reset-names = "ssiu.0\0ssi.0";
			status = "disabled";
			pinctrl-0 = <0x6c 0x6d>;
			pinctrl-names = "default";
			#sound-dai-cells = <0x00>;
			#clock-cells = <0x00>;
			clock-frequency = <0xac4400>;

			rcar_sound,ssiu {

				ssiu-0 {
					dmas = <0x16 0x6e 0x16 0x6f>;
					dma-names = "tx\0rx";
				};

				ssiu-1 {
					dmas = <0x16 0x6c 0x16 0x6d>;
					dma-names = "tx\0rx";
				};

				ssiu-2 {
					dmas = <0x16 0x6a 0x16 0x6b>;
					dma-names = "tx\0rx";
				};

				ssiu-3 {
					dmas = <0x16 0x68 0x16 0x69>;
					dma-names = "tx\0rx";
				};

				ssiu-4 {
					dmas = <0x16 0x66 0x16 0x67>;
					dma-names = "tx\0rx";
				};

				ssiu-5 {
					dmas = <0x16 0x64 0x16 0x65>;
					dma-names = "tx\0rx";
				};

				ssiu-6 {
					dmas = <0x16 0x62 0x16 0x63>;
					dma-names = "tx\0rx";
				};

				ssiu-7 {
					dmas = <0x16 0x60 0x16 0x61>;
					dma-names = "tx\0rx";
				};
			};

			rcar_sound,ssi {

				ssi-0 {
					interrupts = <0x00 0x102 0x04>;
				};
			};
		};

		gsx_osid0_domd {
			xen,passthrough;
			iommus = <0x6e 0x00>;
		};

		gsx_osid1_domu {
			xen,passthrough;
			iommus = <0x6e 0x01>;
		};

		gsx_osid_rest {
			xen,passthrough;
			iommus = <0x6e 0x02 0x6e 0x03 0x6e 0x04 0x6e 0x05 0x6e 0x06 0x6e 0x07>;
		};

		ssi-0 {
			xen,passthrough;
		};
	};

	refclk {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x249f000>;
	};

	thermal-zones {

		sensor-thermal1 {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x00>;
			thermal-sensors = <0x6f 0x00>;

			trips {

				sensor1-crit {
					temperature = <0x1d4c0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		sensor-thermal2 {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x00>;
			thermal-sensors = <0x6f 0x01>;

			trips {

				sensor2-crit {
					temperature = <0x1d4c0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		sensor-thermal3 {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x00>;
			thermal-sensors = <0x6f 0x02>;

			trips {

				sensor3-crit {
					temperature = <0x1d4c0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		sensor-thermal4 {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x00>;
			thermal-sensors = <0x6f 0x03>;

			trips {

				sensor4-crit {
					temperature = <0x1d4c0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts-extended = <0x0b 0x01 0x0d 0xf08 0x0b 0x01 0x0e 0xf08 0x0b 0x01 0x0b 0xf08 0x0b 0x01 0x0a 0xf08>;
	};
	scmi_shm_0: sram@47ff0000 {
		compatible = "arm,scmi-shmem";
		reg = <0x0 0x47ff0000 0x0 0x1000>;
	};

	chosen {
		stdout-path = "serial0:921600n8";
		bootargs = "dom0_mem=320M console=dtuart dtuart=/soc/serial@e6540000 dom0_max_vcpus=2 loglvl=all xsm=flask flask=permissive bootscrub=0 console_timestamps=boot dom0=sci-agent-id=0";
		xen,dom0-bootargs = "root=/dev/ram0 console=hvc0 ignore_loglevel clk_ignore_unused";
		ranges;

		xen {
			comaptible = "xen,hypervisor";
			ranges;

			xen_scmi_config {
				compatible = "xen,sci";
				#address-cells = <0x02>;
				#size-cells = <0x02>;
				ranges;
				scmi-secondary-agents = <
					0x82000002 &scmi_shm_0
					0x82000004 &scmi_shm_2
					0x82000005 &scmi_shm_3
					0x82000006 &scmi_shm_4
					0x82000007 &scmi_shm_5
					0x82000008 &scmi_shm_6
					0x82000009 &scmi_shm_7
					>;
				#scmi-secondary-agents-cells = <2>;

				scmi_shm_2: sram@47ff2000 {
					compatible = "arm,scmi-shmem";
					reg = <0x0 0x47ff2000 0x0 0x1000>;
					xen,passthrough;
				};
				scmi_shm_3: sram@47ff3000 {
					compatible = "arm,scmi-shmem";
					reg = <0x0 0x47ff3000 0x0 0x1000>;
					xen,passthrough;
				};
				scmi_shm_4: sram@47ff4000 {
					compatible = "arm,scmi-shmem";
					reg = <0x0 0x47ff4000 0x0 0x1000>;
					xen,passthrough;
				};
				scmi_shm_5: sram@47ff5000 {
					compatible = "arm,scmi-shmem";
					reg = <0x0 0x47ff5000 0x0 0x1000>;
					xen,passthrough;
				};
				scmi_shm_6: sram@47ff6000 {
					compatible = "arm,scmi-shmem";
					reg = <0x0 0x47ff6000 0x0 0x1000>;
					xen,passthrough;
				};
				scmi_shm_7: sram@47ff7000 {
					compatible = "arm,scmi-shmem";
					reg = <0x0 0x47ff7000 0x0 0x1000>;
					xen,passthrough;
				};

				// Xen SCMI management channel
				scmi_shm_1: sram@47ff1000 {
					compatible = "arm,scmi-shmem";
					reg = <0x0 0x47ff1000 0x0 0x1000>;
				};

				scmi_xen: scmi {
					compatible = "arm,scmi-smc";
					arm,smc-id = <0x82000003>;
					#address-cells = <1>;
					#size-cells = <0>;
					#access-controller-cells = <1>;
					shmem = <&scmi_shm_1>;
				};
			};

		};

		modules {
			#address-cells = <0x02>;
			#size-cells = <0x02>;

			module@1 {
				compatible = "xen,linux-zimage\0xen,multiboot-module";
				reg = <0x00 0x48300000 0x00 0x2000000>;
			};

			module@2 {
				compatible = "xen,xsm-policy\0xen,multiboot-module";
				reg = <0x00 0x48070000 0x00 0x10000>;
			};
		};
	};

	memory@48000000 {
		device_type = "memory";
		reg = <0x00 0x48000000 0x00 0x78000000>;
	};

	memory@480000000 {
		device_type = "memory";
		reg = <0x04 0x80000000 0x00 0x80000000>;
	};

	memory@600000000 {
		device_type = "memory";
		reg = <0x06 0x00 0x01 0x00>;
	};

	regulator-1p8v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-1.8V";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-boot-on;
		regulator-always-on;
		phandle = <0x43>;
	};

	regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-boot-on;
		regulator-always-on;
		phandle = <0x42>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		linux,cr_region@60000000 {
			no-map;
			reg = <0x00 0x60000000 0x00 0x20000000>;
		};

		linux,rvgc_region@b0000000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0xb0000000 0x00 0x10000000>;
			linux;
		};

		linux,rvgc_region1@a0000000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0xa0000000 0x00 0x10000000>;
			linux;
		};
	};

	cr52_rproc@7FF00000 {
		compatible = "renesas,rproc";
		reg = <0x00 0x7ff00000 0x00 0x1000>;
	};

	firmware {

		scmi {
			compatible = "arm,scmi-smc";
			arm,smc-id = <0x82000002>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			#access-controller-cells = <0x01>;
			shmem = <&scmi_shm_0>;

			scmi_reset: protocol@16 {
				reg = <0x16>;
				#reset-cells = <0x01>;
			};

			scmi_power: protocol@11 {
				reg = <0x11>;
				#power-domain-cells = <0x01>;
			};

			scmi_clocks: protocol@14 {
				reg = <0x14>;
				#clock-cells = <0x01>;
			};
		};
	};
};
